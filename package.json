{
  "name": "tengo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node scripts/contrast-check.mjs && vitest run",
    "lint": "eslint . && node scripts/check-dashes.mjs && node scripts/check-secrets.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "fonts:check": "node scripts/fonts-check.mjs",
    "i18n:translate": "node scripts/translate.mjs",
    "contrast": "node scripts/contrast-check.mjs",
    "icons": "python3 scripts/make-icons.py",
    "screens": "playwright test",
    "a11y": "playwright test tests/a11y.spec.ts",
    "budget": "node scripts/bundle-budget.mjs",
    "coverage": "vitest run --coverage",
    "test:rls": "bash scripts/test-rls.sh"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "i18next": "^26.5.3",
    "input-otp": "1.5.0",
    "lucide-react": "^1.60.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fontkit": "^2.0.4",
    "globals": "^17.13.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vite-node": "^3.2.4",
    "vitest": "^5.0.5"
  }
}
