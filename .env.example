# Copy to .env.local (never committed) and fill in. The app runs fully as a guest with none of these set.
# Only the public anon key belongs here. The service role key must never be in client code, this file or the repo.

# Supabase project (Settings, API). Leave empty to run without accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Who is responsible for Tengo, shown in the privacy notice. Fill before any real launch.
VITE_RESPONSIBLE_PARTY=
VITE_RESPONSIBLE_PARTY_ADDRESS=
VITE_INFORMATION_OFFICER=
VITE_PRIVACY_EMAIL=

# Off by default. Turn on only after two first-language Tshivenda speakers confirm the meaning of "mutengo".
VITE_SHOW_NAME_STORY=false
